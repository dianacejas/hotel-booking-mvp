# Configuración del servidor
# Copia este archivo a .env y ajusta los valores si es necesario

# Puerto en el que escucha el servidor Express
PORT=5000

# Cadena de conexión a MongoDB local (compatible con MongoDB Compass)
MONGO_URI=mongodb://127.0.0.1:27017/hotel_booking_db

# Secreto para firmar los tokens JWT (usa una cadena larga y aleatoria en producción)
JWT_SECRET=change-me-to-a-long-random-secret

# Caducidad del token (p. ej. 7d, 1h)
JWT_EXPIRES_IN=7d

# Access Token de Mercado Pago en MODO PRUEBA (empieza por TEST-).
# Consíguelo en https://www.mercadopago.com.ar/developers/panel/app →
# "Credenciales de prueba" de tu aplicación. Déjalo vacío para que el
# botón "Pagar con Mercado Pago" muestre un aviso en lugar de fallar.
MP_ACCESS_TOKEN=